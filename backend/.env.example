# Environment Variables Template
# Copy this file to .env and update with your values

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/psychology-clinic

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please

# Optional: OpenAI API Key (for chatbot)
OPENAI_API_KEY=your-openai-api-key-here

# Landing page contact form: message destination + SMTP (both optional —
# without SMTP_HOST, messages are just logged instead of sent)
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Calendar integrations (Settings > Integrations) — sync external calendars
# (Google, Outlook, iCloud) into the app as read-only "busy" blocks.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALENDAR_ENCRYPTION_KEY=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Add GOOGLE_CALENDAR_REDIRECT_URI as an
# authorized redirect URI, and enable the Google Calendar API.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar-integrations/google/callback

# Azure Portal > App registrations > New registration (Web platform).
# Add MICROSOFT_CALENDAR_REDIRECT_URI as a redirect URI, and grant the
# Microsoft Graph delegated permissions Calendars.Read + User.Read.
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar-integrations/outlook/callback

# iCloud needs no app registration — each doctor connects with their Apple ID
# email and an app-specific password generated at appleid.apple.com.
